HOST=127.0.0.1
PORT=8787

# Bootstrap 时创建的 admin 账户（仅首次启动有效）
ADMIN_PASSWORD=admin1234
# 调用 POST /api/admin/credit 需要的 token（写在请求头 X-Admin-Token）
ADMIN_TOKEN=replace-me

# 腾讯云 COS 对象存储（可选）：本地载入的视频当参考素材时，会先上传 COS 换成公网外链，
# 再喂给火山 Ark（Ark 的 reference_video 只认 http(s) 地址，不收 base64 data URL）。
# 桶名已含 APPID，形如 <name>-<appid>。不配则本地视频参考会报错提示。
COS_BUCKET=
COS_REGION=
COS_SECRET_ID=
COS_SECRET_KEY=
